DATABASE_URL="postgresql://petrobox:PASSWORD@127.0.0.1:5555/contenedores?schema=public&connection_limit=5&pool_timeout=20"

# La base vive en bilbo. El pg_hba de bilbo todavia no habilita a petrobox desde
# la tailnet, asi que se accede por tunel SSH:  ./scripts/tunel-bilbo.sh -d
# Si en algun momento se abre el acceso directo, apuntar a bilbo:5432.

# Secreto para firmar las sesiones (generar con: openssl rand -base64 32)
AUTH_SECRET="cambiar-por-un-secreto-largo-y-aleatorio"

# bilbo comparte PostgreSQL con otras bases y está cerca de max_connections=100,
# así que esta app se limita a 5 conexiones.

# Servir por HTTP plano en la red local (sin HTTPS): la cookie de sesión deja
# de marcarse como Secure. Con HTTPS, poner 0 o quitarlo.
COOKIE_INSECURE=1

# Qué sistema sirve este proceso: "alquileres" o "cerveceria". Con la variable
# puesta, el puerto solo responde por su sistema y manda al otro a su raíz
# (src/proxy.ts). Se setea en los scripts npm, no acá:
#   npm run dev:alquileres   → 3000
#   npm run dev:cerveceria   → 3001
#   npm run dev:ambos        → los dos a la vez
# Sin la variable (npm run dev) se sirven los dos sistemas en un solo puerto.

# Reporte de bugs → Tickets (pedir una API key de app_client para el proyecto).
TICKETS_API=https://tickets.petroboxinc.com/api
TICKETS_API_KEY=
TICKETS_PROJECT=Contenedores
